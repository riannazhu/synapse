  "components": {
    "schemas": {
      "Block": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "maxLength": 50000,
            "title": "Text"
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "text",
              "transcript",
              "summary",
              "handwriting",
              "chat"
            ],
            "title": "Source Kind",
            "default": "text"
          },
          "attachment_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attachment Id"
          },
          "reviewed": {
            "type": "boolean",
            "title": "Reviewed",
            "default": false
          },
          "included": {
            "type": "boolean",
            "title": "Included",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "title": "Block"
      },
      "Commit": {
        "properties": {
          "expected_draft_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Draft Version"
          },
          "included_block_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Included Block Ids"
          },
          "approval": {
            "type": "boolean",
            "const": true,
            "title": "Approval"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_draft_version",
          "included_block_ids",
          "approval"
        ],
        "title": "Commit"
      },
      "Complete": {
        "properties": {
          "checksum": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Checksum"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "checksum"
        ],
        "title": "Complete"
      },
      "Conversation": {
        "properties": {
          "entry_id": {
            "type": "string",
            "format": "uuid",
            "title": "Entry Id"
          },
          "history_enabled": {
            "type": "boolean",
            "title": "History Enabled",
            "default": false
          },
          "retain_transcript": {
            "type": "boolean",
            "title": "Retain Transcript",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "entry_id"
        ],
        "title": "Conversation"
      },
      "ConversationDraft": {
        "properties": {
          "through_sequence": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Through Sequence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "through_sequence"
        ],
        "title": "ConversationDraft"
      },
      "CreateEntry": {
        "properties": {
          "entry_date": {
            "type": "string",
            "format": "date",
            "title": "Entry Date"
          },
          "mode": {
            "type": "string",
            "enum": [
              "text",
              "chat",
              "voice",
              "handwriting"
            ],
            "title": "Mode"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "entry_date",
          "mode"
        ],
        "title": "CreateEntry"
      },
      "Draft": {
        "properties": {
          "expected_draft_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Draft Version"
          },
          "blocks": {
            "items": {
              "$ref": "#/components/schemas/Block"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Blocks"
          },
          "entry_date": {
            "type": "string",
            "format": "date",
            "title": "Entry Date"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_draft_version",
          "blocks",
          "entry_date"
        ],
        "title": "Draft"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Message": {
        "properties": {
          "client_message_id": {
            "type": "string",
            "format": "uuid",
            "title": "Client Message Id"
          },
          "text": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_message_id",
          "text"
        ],
        "title": "Message"
      },
      "TopicEdit": {
        "properties": {
          "expected_topic_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Topic Version"
          },
          "label": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "hidden": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hidden"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_topic_version"
        ],
        "title": "TopicEdit"
      },
      "Upload": {
        "properties": {
          "filename": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename"
          },
          "mime_type": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "audio/mpeg",
              "audio/mp4",
              "audio/wav",
              "audio/webm"
            ],
            "title": "Mime Type"
          },
          "byte_size": {
            "type": "integer",
            "maximum": 26214400.0,
            "exclusiveMinimum": 0.0,
            "title": "Byte Size"
          },
          "checksum": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Checksum"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "filename",
          "mime_type",
          "byte_size",
          "checksum"
        ],
        "title": "Upload"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
