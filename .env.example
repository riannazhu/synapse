# Copy to .env and insert your key locally. Never commit the real key.
# fixture = named hard-coded fictional inputs only, no API calls.
# live = Gemini calls; explicitly opt in when you want to spend quota.
SYNAPSE_MODEL_MODE=live
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Track A backend settings
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
MEDIA_BUCKET=journal-media
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PIPELINE_VERSION=analysis-v4
HANDLER_MODULE=server.providers.gemini
GLOBAL_JOB_CONCURRENCY=1
SERVICE_MODULE=
GEMINI_REQUESTS_PER_MINUTE=4
GEMINI_DAILY_REQUEST_LIMIT=20
